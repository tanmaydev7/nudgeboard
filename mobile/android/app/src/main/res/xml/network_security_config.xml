<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Android cannot express RFC1918 CIDR in domain-config.
      Cleartext is required for same-LAN ws:// pairing; JS rejects non-private hosts.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
